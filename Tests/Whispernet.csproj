<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="N0.IrohNet" Version="0.101.13" />
  </ItemGroup>

  <Target Name="OverrideIrohNativeWithMainlineDht" AfterTargets="Build">
    <ItemGroup>
      <CustomIrohNatives Include="..\native\runtimes\**" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomIrohNatives)"
          DestinationFiles="@(CustomIrohNatives->'$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
