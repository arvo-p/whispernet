<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\N0.IrohNet\N0.IrohNet\N0.IrohNet.csproj" />
    <ProjectReference Include="..\src\Whispernet.Core\Whispernet.Core.csproj" />
    <ProjectReference Include="..\src\Whispernet.Transport.Iroh\Whispernet.Transport.Iroh.csproj" />
    <ProjectReference Include="..\src\Whispernet.App.Messaging\Whispernet.App.Messaging.csproj" />
  </ItemGroup>

  <Target Name="OverrideIrohNativeWithMainlineDht" AfterTargets="Build">
    <ItemGroup>
      <CustomIrohNatives Include="..\native\runtimes\**" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomIrohNatives)"
          DestinationFiles="@(CustomIrohNatives->'$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
