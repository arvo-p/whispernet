<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\N0.IrohNet\N0.IrohNet\N0.IrohNet.csproj" />
    <ProjectReference Include="..\Whispernet.Core\Whispernet.Core.csproj" />
  </ItemGroup>

  <Target Name="OverrideIrohNativeWithMainlineDht" AfterTargets="Build">
    <ItemGroup>
      <CustomIrohNatives Include="..\..\native\runtimes\**" />
    </ItemGroup>
    <Copy SourceFiles="@(CustomIrohNatives)"
          DestinationFiles="@(CustomIrohNatives->'$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
